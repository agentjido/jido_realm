defmodule RealmDemo.MixProject do
  use Mix.Project

  def project do
    [
      app: :realm_edit_demo,
      version: "0.1.0",
      elixir: "~> 1.20",
      deps: [{:phoenix, "1.8.17"}, {:phoenix_html, "4.4.0"}, {:bandit, "1.15.0"}]
    ]
  end

  def application do
    [mod: {RealmDemo.Application, []}, extra_applications: [:logger]]
  end
end
